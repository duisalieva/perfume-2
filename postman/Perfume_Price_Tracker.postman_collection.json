{
  "info": {
    "name": "Perfume Price Tracker — HW4 API",
    "_postman_id": "9b77b92e-869b-493f-8c7e-2c71f88310cc",
    "description": "Full 19-endpoint Flask/PostgreSQL API demo. Run folders 01–08 in order. Creates and cleans up isolated test records; do not use real record IDs for DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "description": "",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Simple health response. Does not check database directly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Create Test Data",
      "description": "Run top to bottom first. These requests are non-destructive to existing real perfumes.",
      "item": [
        {
          "name": "POST Test Perfume (save ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/perfumes",
            "description": "Creates only a temporary test perfume; saves its generated ID in testPerfumeId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Test Brand\",\n  \"name\": \"HW4 Demo Perfume\",\n  \"concentration\": \"EDP\",\n  \"volume_ml\": 100,\n  \"remaining_ml\": 95,\n  \"top_notes\": \"Bergamot\",\n  \"heart_notes\": \"Rose\",\n  \"base_notes\": \"Musk\",\n  \"fragrance_family\": \"Floral\",\n  \"status\": \"owned\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const data = pm.response.json(); pm.collectionVariables.set(\"testPerfumeId\", String(data.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Test Retailer (save ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/retailers",
            "description": "Creates a temporary test retailer with a timestamp in the name; saves generated ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HW4 Demo Store {{$timestamp}}\",\n  \"website_url\": \"https://example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const data = pm.response.json(); pm.collectionVariables.set(\"testRetailerId\", String(data.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Test Offer (save ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/price-offers",
            "description": "Requires both testPerfumeId and testRetailerId populated by previous POST requests. Price is illustrative.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perfume_id\": {{testPerfumeId}},\n  \"retailer_id\": {{testRetailerId}},\n  \"volume_ml\": 100,\n  \"price_kzt\": 150000,\n  \"product_url\": \"https://example.com/hw4-test-offer\",\n  \"is_available\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const data = pm.response.json(); pm.collectionVariables.set(\"testOfferId\", String(data.id)); }"
                ]
              }
            }
          ]
        }
      ]
    },
